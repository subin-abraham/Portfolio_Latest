# Pulled by `neon deploy` / `neon env pull` (do not commit real values)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
NEON_BRANCH=production
NEON_BRANCH_ID=
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_FUNCTION_HOST_SUFFIX=

# Optional — admin UI uses the /api/auth BFF; Neon Auth is server-side only.
# VITE_NEON_AUTH_URL=

# Cookie / app
NODE_ENV=development
APP_ORIGIN=http://localhost:8080
API_PORT=8787

# First-admin bootstrap only. Keep false in production after the first account.
# Server gate (404 when false). Vite flag only controls the login UI / route.
ENABLE_ADMIN_REGISTRATION=false
VITE_ENABLE_ADMIN_REGISTRATION=false

# Rate limiting (requests per window) for local API guards
AUTH_RATE_LIMIT_MAX=8
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Hygraph — server-only image uploads / asset sync (never expose to the browser)
# Content API endpoint from Hygraph → Project settings → Endpoints
HYGRAPH_ENDPOINT=https://REGION.cdn.hygraph.com/content/PROJECT/ENVIRONMENT
HYGRAPH_MANAGEMENT_TOKEN=
# Use DRAFT until assets are published in Hygraph Studio; then PUBLISHED
HYGRAPH_ASSET_STAGE=DRAFT

# Phase B (not required for Phase A)
# RESEND_API_KEY=
# EMAIL_FROM=
